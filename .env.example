# Template for the local configuration.
# Copy to .env and adjust if needed – .env is not committed to Git.

# Port under which the app is reachable in the browser (http://<computer>:APP_PORT)
APP_PORT=8090

# Database
DB_NAME=werkstatt
DB_USER=werkstatt
DB_PASSWORD=werkstatt
DB_PORT=5432

# Backups (docs/operations.md)
# Folder for the nightly backups – on the NAS e.g. /volume1/kruegeldata/Datensicherung/werkstatt
BACKUP_DIR=./Datensicherung
# When (cron: minute hour day month weekday, Swiss time) and how many days they are kept
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30
