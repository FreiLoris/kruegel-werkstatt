# Vorlage für die lokale Konfiguration.
# Kopieren nach .env und bei Bedarf anpassen – .env wird nicht ins Git eingecheckt.

# Port, unter dem die App im Browser erreichbar ist (http://<rechner>:APP_PORT)
APP_PORT=8090

# Datenbank
DB_NAME=werkstatt
DB_USER=werkstatt
DB_PASSWORD=werkstatt
DB_PORT=5432
