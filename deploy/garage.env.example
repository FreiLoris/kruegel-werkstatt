# Configuration of a new workshop's installation (release channel) – docs/installation.md.
# Copy to ".env" next to compose.yaml and fill in. The .env contains the database password:
# never send it by mail, keep it in the password manager.

# Own, long password for the database (e.g. 24 random characters, letters and digits only).
# Set it ONCE before the first start – changing it later does not change the existing database.
DB_PASSWORD=bitte-eigenes-passwort-eintragen

# Port in the browser: http://<address of the device>:8090
APP_PORT=8090

# Folder for the nightly backups. Synology: a folder that exists, e.g.
# /volume1/docker/werkstatt/Datensicherung – Windows/Linux: ./Datensicherung (created on the first start)
BACKUP_DIR=/volume1/docker/werkstatt/Datensicherung
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30

# "latest" = always the newest release; a fixed one like "v1.5.0" stays on it
APP_VERSION=latest

# When to look for a new release (seconds minutes hours day month weekday). Only at lunch, so a
# restart never disturbs the work: 0 0 12 * * *
UPDATE_SCHEDULE=0 0 12 * * *

# SMS reminders (optional): the access of the workshop's own ASPSMS account (aspsms.com →
# Userkey, API password). Empty = no SMS. On and off in the app: Einstellungen → Kundenerinnerungen.
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
