# Configuration of the app on the NAS – copy to ".env" (same folder as compose.yaml) and fill in.
# The .env contains the database password: never commit it, never send it by mail.

# Own, long password for the database (e.g. 24 random characters, letters and digits only).
# Set it ONCE before the first start – changing it later does not change the existing database.
DB_PASSWORD=bitte-eigenes-passwort-eintragen

# Port in the browser: http://<NAS>:8090
APP_PORT=8090

# Folder for the nightly backups (must exist)
BACKUP_DIR=/volume1/kruegeldata/Datensicherung/werkstatt
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30

# Which version of the app: "latest" = newest from main, or a commit like "493ba11" to go back
APP_VERSION=latest
