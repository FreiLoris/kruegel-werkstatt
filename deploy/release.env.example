# Configuration of the NAS in the workshop (release channel) – copy to ".env" next to
# compose.yaml and fill in. The .env contains the database password: never commit it, never send
# it by mail.

# Own, long password for the database (e.g. 24 random characters, letters and digits only).
# Set it ONCE before the first start – changing it later does not change the existing database.
DB_PASSWORD=bitte-eigenes-passwort-eintragen

# Port in the browser: http://<NAS>:8090
APP_PORT=8090

# Folder for the nightly backups (must exist)
BACKUP_DIR=/volume1/kruegeldata/Datensicherung/werkstatt
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30

# Which version of the app: "latest" = the newest release (docs/deployment-nas.md, "Releases"),
# or a fixed one like "v1.0.0" to stay on it (Watchtower then changes nothing)
APP_VERSION=latest

# When Watchtower looks for a new release (seconds minutes hours day month weekday):
# every 5 minutes – a release reaches the workshop right away. Only at lunch: 0 0 12 * * *
UPDATE_SCHEDULE=0 */5 * * * *

# SMS reminders (17c): the access of the workshop's ASPSMS account (aspsms.com → Userkey, API
# password). Empty = no SMS, reminders only logged. On and off in the app: Einstellungen →
# Kundenerinnerungen.
ASPSMS_USERKEY=
ASPSMS_PASSWORD=
