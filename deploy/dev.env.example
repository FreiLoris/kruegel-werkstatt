# Configuration of a test instance (dev channel: every merge to main) – Reto's computer in the
# office, Loris' computer. Copy to ".env" next to compose.yaml and fill in. Only test data here,
# the real data is on the NAS.

# Password of the database of this instance (letters and digits). Set it ONCE before the first
# start – changing it later does not change the existing database.
DB_PASSWORD=bitte-eigenes-passwort-eintragen

# Port in the browser: http://localhost:8090
APP_PORT=8090

# Folder for the nightly backups (relative to compose.yaml – it is created on the first start)
BACKUP_DIR=./Datensicherung
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=7

# "dev" = always the newest state of main
APP_VERSION=dev

# Every 5 minutes Watchtower looks for a new image (seconds minutes hours day month weekday)
UPDATE_SCHEDULE=0 */5 * * * *

# No ASPSMS_USERKEY / ASPSMS_PASSWORD here: a test instance sends no SMS (APP_VERSION=dev blocks it).
